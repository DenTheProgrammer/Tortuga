{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tortuga",
  "version": "0.1.5",
  "identifier": "app.tortuga.client",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm --prefix ../ui run dev",
    "beforeBuildCommand": "npm --prefix ../ui run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tortuga",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 560,
        "visible": false,
        "dragDropEnabled": true,
        "backgroundColor": "#111317"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "deb",
      "appimage",
      "dmg"
    ],
    "category": "Utility",
    "shortDescription": "Torrent client",
    "longDescription": "Tortuga — a simple torrent client with streaming, file priorities, RSS and VPN-aware networking.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "torrent"
        ],
        "name": "BitTorrent file",
        "description": "BitTorrent file",
        "mimeType": "application/x-bittorrent",
        "role": "Viewer"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Russian",
          "English"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "template": "installer/installer.nsi",
        "sidebarImage": "installer/sidebar.bmp",
        "headerImage": "installer/header.bmp"
      },
      "wix": {
        "language": [
          "ru-RU",
          "en-US"
        ]
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "magnet"
        ]
      }
    }
  }
}
